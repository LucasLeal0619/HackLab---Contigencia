<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Endereços fixos nos testes: portas trocadas no .env local (ex.: 8000 ocupada) não mudam CORS/Sanctum. -->
        <env name="APP_URL" value="http://localhost:8000"/>
        <env name="FRONTEND_URL" value="http://localhost:5174"/>
        <env name="CORS_ALLOWED_ORIGINS" value="http://localhost:5174"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost,localhost:5174,127.0.0.1,127.0.0.1:5174,127.0.0.1:8000,::1,localhost:8000"/>
        <!-- PostgreSQL exclusivo de testes (credenciais em .env.testing). Nunca hacklab_dev nem Supabase. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="hacklab_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
