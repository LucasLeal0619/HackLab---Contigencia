APP_NAME=HackLab
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend Vue (SPA). Usado por CORS e Sanctum.
# Acesse front e API pelo mesmo host (localhost ou 127.0.0.1) para o cookie de sessão funcionar.
FRONTEND_URL=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5174
SANCTUM_STATEFUL_DOMAINS=localhost:5174,127.0.0.1:5174

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL. Desenvolvimento: container "postgres" do docker-compose.yml (raiz).
# Rodando o Laravel DENTRO do container, o compose já define DB_HOST=postgres e DB_PORT=5432.
# Rodando o Laravel na máquina (fora do Docker), use 127.0.0.1 e a porta publicada (5442).
# Produção (Supabase) NÃO entra aqui: só nas variáveis do Render. Veja hacklab_docs/docs/banco-de-dados.md.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5442
DB_DATABASE=hacklab_dev
DB_USERNAME=hacklab
DB_PASSWORD=hacklab
DB_SEARCH_PATH=hacklab
# Container local não tem SSL. Produção usa require (ou verify-full).
DB_SSLMODE=disable

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail (primeiro acesso e redefinição de senha). Desenvolvimento: "log" grava o e-mail em storage/logs.
# Produção (Fase 12): MAIL_MAILER=smtp com host/porta/usuário/senha só nas variáveis do servidor, nunca no Git.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@hacklab.local"
MAIL_FROM_NAME="HackLab"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Integração Even3 (só no backend; nunca commitar token real)
EVEN3_ENABLED=false
EVEN3_BASE_URL=https://api.even3.com/api/v2
EVEN3_API_TOKEN=
# Nome do header em que a Even3 envia o token de segurança do webhook (confirmar no PoC real; sem valor padrão).
EVEN3_WEBHOOK_HEADER=
# Diferente do EVEN3_API_TOKEN.
EVEN3_WEBHOOK_SECRET=

# Administrador de desenvolvimento (só local/testing). Padrão: admin@hacklab.local / hacklab123
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
