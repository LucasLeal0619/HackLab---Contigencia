APP_NAME=HackLab
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend Vue (SPA). Usado por CORS e Sanctum.
# Acesse front e API pelo mesmo host (localhost ou 127.0.0.1) para o cookie de sessão funcionar.
FRONTEND_URL=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5174
SANCTUM_STATEFUL_DOMAINS=localhost:5174,127.0.0.1:5174
# Cache do preflight CORS no navegador, em segundos (padrão 7200).
# CORS_MAX_AGE=7200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Produção (Render, alvo prod do Dockerfile) — só nas variáveis do Render, ver hacklab_docs/docs/infraestrutura.md §3.2:
# TRUSTED_PROXIES=127.0.0.1,::1      proxy local do Render (exato, nunca *); vazio em desenvolvimento
# HACKLAB_EDGE_CLIENT_IP_HEADER=CF-Connecting-IP
# HACKLAB_NETLIFY_PROXY_SECRET=      segredo do proxy assinado (mesmo valor de HACKLAB_PROXY_SIGNATURE_SECRET no Netlify)
# HACKLAB_MIGRATE_ON_START=true      Free: só no primeiro deploy/migration nova, depois false (pago: Pre-Deploy)
# FRANKENPHP_NUM_THREADS=4           requests PHP simultâneos
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco do desenvolvimento local: MySQL Server 8.0.19+ instalado no Windows, sem Docker (README, "Desenvolvimento local").
# Crie os bancos e o usuário com scripts\windows\criar-bancos-mysql.sql e coloque aqui a MESMA senha usada lá.
# Os testes usam o banco hacklab_test com este mesmo usuário (phpunit.mysql.xml troca o banco); nunca o hacklab_dev.
# Produção (PostgreSQL no Supabase) NÃO entra aqui: só nas variáveis do Render.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hacklab_dev
DB_USERNAME=hacklab
DB_PASSWORD=TROQUE_ESTA_SENHA
# Só para PostgreSQL (alternativa com Docker: o docker-compose.yml define estas variáveis sozinho).
DB_SEARCH_PATH=hacklab
DB_SSLMODE=disable

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail (primeiro acesso e redefinição de senha). Desenvolvimento: "log" grava o e-mail em storage/logs.
# Produção (Fase 12): MAIL_MAILER=smtp com host/porta/usuário/senha só nas variáveis do servidor, nunca no Git.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@hacklab.local"
MAIL_FROM_NAME="HackLab"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Integração Even3 (só no backend; nunca commitar token real)
EVEN3_ENABLED=false
EVEN3_BASE_URL=https://api.even3.com/api/v2
EVEN3_API_TOKEN=
# Nome do header em que a Even3 envia o token de segurança do webhook (confirmar no PoC real; sem valor padrão).
EVEN3_WEBHOOK_HEADER=
# Diferente do EVEN3_API_TOKEN.
EVEN3_WEBHOOK_SECRET=

# Administrador de desenvolvimento (só local/testing). Padrão: admin@hacklab.local / hacklab123
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
