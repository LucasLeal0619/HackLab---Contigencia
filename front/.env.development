# Desenvolvimento local: API Laravel de "php artisan serve" (ou do docker compose), na porta 8000.
# Se o Laravel estiver em outra porta, crie front\.env.development.local com VITE_API_URL=http://localhost:<porta>
# (não vai para o Git). Use sempre "localhost" no front e na API: o cookie de sessão depende do mesmo host.
VITE_API_URL=http://localhost:8000
